# Database
DATABASE_URL=sqlite+aiosqlite:///./doc_action_center.db

# Security (change this in production)
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Credential encryption (M1 extraction foundations).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required as soon as any credential is stored; the API refuses to start without it then.
APP_ENCRYPTION_KEY=

# App
DEBUG=True
SETUP_COMPLETE_FILE=.setup-complete

# Worker (python -m app.worker)
WORKER_POLL_SECONDS=2

# Frontend base URL used in email links
FRONTEND_URL=http://localhost:5173
